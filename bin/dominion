#!/usr/bin/env python3
## dominion — Dashboard: slot status + last 5 test runs with pass/fail counts
"""dominion — slot + test run dashboard"""

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import B, DIM, GREEN, RED, YELLOW, CYAN, RST, parse_junit, fmt_run_id, latest_run_age

SLOTS_JSON  = Path("/blox/adixon1/.slots.json")
RESULTS_DIR = Path(os.environ.get("NIOS_TEST_OUTPUT_DIR", "/blox/adixon1/scripts/nios_test/results"))


def running_containers():
    try:
        out = subprocess.check_output(["docker", "ps", "--format", "{{.Names}}"], text=True, stderr=subprocess.DEVNULL)
        return set(out.split())
    except Exception:
        return set()


def short_wt(wt):
    return Path(wt).name if wt else "—"


def load_runs(n=5):
    if not RESULTS_DIR.exists():
        return []
    runs = []
    for d in sorted(RESULTS_DIR.iterdir(), reverse=True)[:n]:
        junit = d / "junit.xml"
        info = parse_junit(junit) if junit.exists() else {"script": "—", "target": "—", "passed": None, "failed": None, "skipped": None}
        info["run_id"] = d.name
        runs.append(info)
    return runs


def result_str(p, f, s):
    if p is None:
        return f"{DIM}no summary{RST}"
    pc = f"{GREEN}{B}{p}✓{RST}"
    fc = f"{RED}{B}{f}✗{RST}" if f else f"{DIM}{f}✗{RST}"
    sc = f"{YELLOW}{s}—{RST}" if s else f"{DIM}{s}—{RST}"
    verdict = f"  {RED}{B}FAIL{RST}" if f else f"  {GREEN}PASS{RST}"
    return f"{pc}  {fc}  {sc}{verdict}"


def main():
    slots_data = json.loads(SLOTS_JSON.read_text()) if SLOTS_JSON.exists() else {}
    running = running_containers()

    last_run = latest_run_age(RESULTS_DIR)

    print()
    print(f"  {B}{CYAN}SLOTS{RST}")
    print(f"  {'─' * 10}  {'─' * 9}  {'─' * 42}  {'─' * 14}")
    print(f"  {'SLOT':<10}  {'NCC':<9}  {'WORKTREE':<42}  {'LAST RUN':<14}")
    print(f"  {'─' * 10}  {'─' * 9}  {'─' * 42}  {'─' * 14}")
    for slot, info in slots_data.items():
        wt      = short_wt(info.get("worktree", ""))
        is_run  = slot in running
        sc      = f"{GREEN}{B}" if is_run else DIM
        status  = "running" if is_run else "stopped"
        print(f"  {CYAN}{B}{slot:<10}{RST}  {sc}{status:<9}{RST}  {wt:<42}  {DIM}{last_run}{RST}")

    print()
    print(f"  {B}{CYAN}RECENT RUNS{RST}")
    runs = load_runs(5)
    if not runs:
        print(f"  {DIM}  no runs yet{RST}")
    else:
        print(f"  {'─' * 16}  {'─' * 22}  {'─' * 14}  {'─' * 18}")
        print(f"  {'TIME':<16}  {'TEST':<22}  {'TARGET':<14}  RESULT")
        print(f"  {'─' * 16}  {'─' * 22}  {'─' * 14}  {'─' * 18}")
        for r in runs:
            ts     = fmt_run_id(r["run_id"])
            script = r["script"][:22]
            target = r["target"][:14]
            res    = result_str(r["passed"], r["failed"], r["skipped"])
            print(f"  {ts:<16}  {script:<22}  {target:<14}  {res}")
    print()


if __name__ == "__main__":
    main()
