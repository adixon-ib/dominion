#!/usr/bin/env python3
## verdict [run_id] — Colorized detail for a run; accepts a prefix (default: latest)
"""verdict [run_id] — detailed view of a test run (default: latest)"""

import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _common import B, DIM, GREEN, RED, YELLOW, CYAN, RST, parse_junit

RESULTS_DIR = Path(os.environ.get("NIOS_TEST_OUTPUT_DIR", "/blox/adixon1/scripts/nios_test/results"))


def find_run(arg):
    if not RESULTS_DIR.exists():
        return None
    if arg:
        # exact match first
        exact = RESULTS_DIR / arg
        if exact.exists():
            return exact
        # prefix match
        for d in sorted(RESULTS_DIR.iterdir(), reverse=True):
            if d.name.startswith(arg):
                return d
        return None
    # latest
    dirs = sorted(RESULTS_DIR.iterdir(), reverse=True)
    return dirs[0] if dirs else None


def print_case(case):
    color = {"PASS": f"{GREEN}{B}", "FAIL": f"{RED}{B}", "SKIP": YELLOW}[case["status"]]
    print(f"  {color}{case['status']}{RST}  {case['name']}  {DIM}({case['duration']:.1f}s){RST}")
    if case["message"]:
        for line in case["message"].rstrip().splitlines():
            print(f"{RED if case['status'] == 'FAIL' else YELLOW}{DIM}      {line}{RST}")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    run_dir = find_run(arg)

    if not run_dir:
        print(f"  {RED}no run found{RST}" + (f": {arg}" if arg else ""))
        sys.exit(1)

    junit = run_dir / "junit.xml"
    if not junit.exists():
        print(f"  {RED}no junit.xml in {run_dir.name}{RST}")
        print(f"  Logs: {run_dir}/")
        sys.exit(1)

    info = parse_junit(junit)

    print()
    print(f"  {CYAN}{B}Run:{RST} {run_dir.name}")
    print(f"  {CYAN}{B}Script:{RST} {info['script']}")
    print(f"  {CYAN}{B}Target:{RST} {info['target']}")
    print()
    for case in info["cases"]:
        print_case(case)

    total = (info["passed"] or 0) + (info["failed"] or 0) + (info["skipped"] or 0)
    print()
    print(f"  {B}{info['passed']} passed, {info['failed']} failed, {info['skipped']} skipped out of {total}{RST}")
    print(f"  {DIM}Logs: {run_dir}/{RST}")
    print()


if __name__ == "__main__":
    main()
